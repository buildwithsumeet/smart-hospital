# Environment Configuration
NODE_ENV=development

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_change_in_production_12345
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production_67890
JWT_REFRESH_EXPIRES_IN=7d

# Microservices Ports
PORT_GATEWAY=8000
PORT_AUTH=8001
PORT_PATIENT=8002
PORT_DOCTOR=8003
PORT_APPOINTMENT=8004
PORT_BILLING=8005
PORT_NOTIFICATION=8006

# Internal Service URLs (used by API Gateway)
AUTH_SERVICE_URL=http://localhost:8001
PATIENT_SERVICE_URL=http://localhost:8002
DOCTOR_SERVICE_URL=http://localhost:8003
APPOINTMENT_SERVICE_URL=http://localhost:8004
BILLING_SERVICE_URL=http://localhost:8005
NOTIFICATION_SERVICE_URL=http://localhost:8006

# PostgreSQL Databases
AUTH_DB_URL=postgresql://postgres:postgres@localhost:5432/hospital_auth_db
PATIENT_DB_URL=postgresql://postgres:postgres@localhost:5432/hospital_patient_db
DOCTOR_DB_URL=postgresql://postgres:postgres@localhost:5432/hospital_doctor_db
APPOINTMENT_DB_URL=postgresql://postgres:postgres@localhost:5432/hospital_appointment_db
BILLING_DB_URL=postgresql://postgres:postgres@localhost:5432/hospital_billing_db

# MongoDB
NOTIFICATION_MONGO_URI=mongodb://localhost:27017/hospital_notification_db

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Ollama / AI Service Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=medllama2

